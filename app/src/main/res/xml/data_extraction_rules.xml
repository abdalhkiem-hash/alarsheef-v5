<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="archive/" />
        <exclude domain="database" path="arsheef.db" />
        <exclude domain="database" path="arsheef.db-shm" />
        <exclude domain="database" path="arsheef.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="archive/" />
        <exclude domain="database" path="arsheef.db" />
    </device-transfer>
</data-extraction-rules>
